        },
        "updatedAt": {
          "type": "string",
          "description": "Update server timestamp"
        }
      },
      "required": ["id", "userId", "theme", "createdAt", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Academic course catalog document without sensitive private MP4 storage paths",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique course ID"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Official academic course code"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Course title"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000,
          "description": "Course description"
        },
        "instructorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Instructor ID"
        },
        "instructorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Instructor display name"
        },
        "status": {
          "type": "string",
          "enum": ["Open for Enrollment", "Active", "Coming Soon"],
          "description": "Enrollment status"
        },
        "level": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"],
          "description": "Difficulty level"
        },
        "thumbnail": {
          "type": "string",
          "maxLength": 2048,
          "description": "Cover thumbnail URL"
        },
        "totalLectures": {
          "type": "number",
          "description": "Planned number of lectures"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether the course is visible in catalog"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Update server timestamp"
        }
      },
      "required": ["id", "code", "title", "description", "instructorId", "instructorName", "status", "level", "thumbnail", "totalLectures", "isPublished", "createdAt", "updatedAt"]
    },
