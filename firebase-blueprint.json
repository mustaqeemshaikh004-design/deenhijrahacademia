  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "AdminRecord" },
      "description": "Trusted administrator roles verified by UID"
    },
    "/users/{userId}": {
      "schema": { "$ref": "UserAccount" },
      "description": "Non-PII root account metadata and role state"
    },
    "/users/{userId}/public/{profileId}": {
      "schema": { "$ref": "UserPublicProfile" },
      "description": "Public display profile with Firebase Storage avatar URL"
    },
    "/users/{userId}/private/{infoId}": {
      "schema": { "$ref": "UserPrivateInfo" },
      "description": "Strictly isolated PII document containing email"
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "UserPreferences" },
      "description": "Per-user UI preferences synced across devices (preferred light/dark mode)"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "Course" },
      "description": "Published curriculum course documents"
    },
    "/courses/{courseId}/enrollments/{userId}": {
      "schema": { "$ref": "CourseEnrollment" },
      "description": "Course enrollment subcollection checked for private MP4 recording streaming"
    },
    "/courses/{courseId}/recordingCatalog/{recordingId}": {
      "schema": { "$ref": "CourseRecordingCatalog" },
      "description": "Safe recording catalog metadata without storage paths"
    },
    "/courses/{courseId}/recordings/{recordingId}": {
      "schema": { "$ref": "CourseRecording" },
      "description": "Enrollment-gated MP4 recording paths and non-downloadable streaming policy"
    },
    "/courses/{courseId}/streamRequests/{requestId}": {
      "schema": { "$ref": "StreamRequest" },
      "description": "Per-request verification records validating auth and enrollment before MP4 bucket streaming"
    },
    "/communityPosts/{postId}": {
      "schema": { "$ref": "CommunityPost" },
      "description": "Community feed posts"
    },
    "/communityPosts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "CommunityComment" },
      "description": "Comments attached to a community feed post"
    },
    "/communityPosts/{postId}/likes/{userId}": {
      "schema": { "$ref": "CommunityLike" },
      "description": "Per-user atomic like receipts for community posts"
    },
    "/chatMessages/{messageId}": {
      "schema": { "$ref": "ChatMessage" },
      "description": "Real-time channel discussion messages"
    },
    "/blogPosts/{blogId}": {
      "schema": { "$ref": "BlogPost" },
      "description": "Published scholastic blog articles"
    },
    "/settings/{settingsId}": {
      "schema": { "$ref": "PlatformSettings" },
      "description": "Platform hero and branding settings"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "AcademyEvent" },
      "description": "Academy pinned poster board and calendar events"
    },
    "/courseReviews/{reviewId}": {
      "schema": { "$ref": "CourseReview" },
      "description": "Publicly readable, author-owned student ratings and reviews for courses"
    },
    "/instructorReviews/{reviewId}": {
      "schema": { "$ref": "InstructorReview" },
      "description": "Publicly readable, author-owned student ratings and reviews for faculty instructors"
    }
  }
}
