{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator privilege record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin user UID"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified administrator email"
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Administrative role"
        },
        "grantedAt": {
          "type": "string",
          "description": "Server timestamp when admin privilege was granted"
        }
      },
      "required": ["uid", "email", "role", "grantedAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Root user role assignment record (no PII)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique user UID"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "teacher", "student"],
          "description": "Role assignment"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Update server timestamp"
        }
      },
      "required": ["id", "role", "createdAt", "updatedAt"]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII public profile containing avatar URL from Firebase Storage",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique user UID"
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "First name"
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Last name"
        },
        "gender": {
          "type": "string",
          "enum": ["male", "female"],
          "description": "Symbolic avatar fallback gender"
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 2048,
          "description": "Firebase Storage profile picture download URL"
        },
        "avatarStoragePath": {
          "type": "string",
          "maxLength": 512,
          "description": "Firebase Storage object path for user avatar"
        },
        "visibility": {
          "type": "string",
          "enum": ["public"],
          "description": "Explicit public profile visibility marker"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Update server timestamp"
        }
      },
      "required": ["id", "firstName", "lastName", "gender", "visibility", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document strictly accessible only by owner or administrator",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
